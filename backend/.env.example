PORT=5000
MONGO_URI=
JWT_SECRET=
BASE_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173
# Optional: dedicated base URL for reset links (recommended in production)
# Example: FRONTEND_RESET_URL=https://farmycure.com
FRONTEND_RESET_URL=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Google OAuth (required for "Login with Google")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match the redirect URI configured in Google Cloud Console
# Production example: https://api.farmycure.com/api/auth/google/callback
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
# Optional: comma-separated DNS servers if SRV lookups fail locally
# DNS_SERVERS=8.8.8.8,1.1.1.1
